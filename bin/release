#!/usr/bin/env bash
# Releases a version: bin/release 1.2.0
#
# Sets the version in Cargo.toml (committing the change if needed), tags vX.Y.Z and
# pushes. The Release workflow then builds the binaries and publishes the GitHub
# release; this script follows it until it finishes.
set -euo pipefail
cd "$(dirname "$0")/.."

die() {
  echo "bin/release: $*" >&2
  exit 1
}

version=${1:-}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "usage: bin/release X.Y.Z"
tag="v$version"

[[ $(git branch --show-current) == main ]] || die "switch to main first"
[[ -z $(git status --porcelain) ]] || die "commit or stash your changes first"
git fetch --quiet --tags origin main
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || die "main differs from origin/main, push or pull first"
! git rev-parse --quiet --verify "refs/tags/$tag" > /dev/null || die "$tag already exists"

head=$(git rev-parse HEAD)
ci=$(gh run list --workflow ci.yml --commit "$head" --limit 1 --json status,conclusion --jq '.[0] | "\(.status) \(.conclusion)"')
[[ $ci == "completed success" ]] || die "CI has not passed for ${head:0:7} (${ci:-no run found})"

current=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
if [[ $current != "$version" ]]; then
  # Only the first `version = ` line, which is the package's.
  perl -0pi -e "s/^version = \"[^\"]*\"/version = \"$version\"/m" Cargo.toml
  cargo check --quiet
  git commit --quiet -am "Release $tag"
  echo "Set the version to $version"
fi

git tag -a "$tag" -m "$tag"
git push --quiet --atomic origin main "$tag"
echo "Pushed $tag, waiting for the Release workflow"

run_id=""
for _ in $(seq 30); do
  run_id=$(gh run list --workflow release.yml --branch "$tag" --limit 1 --json databaseId --jq '.[0].databaseId // empty')
  [[ -n $run_id ]] && break
  sleep 2
done
[[ -n $run_id ]] || die "the Release workflow did not start, check GitHub Actions"

gh run watch "$run_id" --exit-status
gh release view "$tag" --json url --jq .url
